<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="NEVER" prefHeight="760.0" prefWidth="1120.0" style="-fx-background: #1B431E; -fx-background-color: #1B431E;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HostDashboardController">

    <VBox fillWidth="true" minHeight="758.0" style="-fx-background-color: #1B431E;">

        <!-- Top Navbar Khusus Host -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #163819;">
            <padding>
                <Insets bottom="16.0" left="48.0" right="48.0" top="16.0" />
            </padding>

            <ImageView fitHeight="45.0" fitWidth="45.0" onMouseClicked="#handleLogoClick" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                <image>
                    <Image url="@images/SinggahLogo.png" />
                </image>
            </ImageView>

            <Label onMouseClicked="#handleLogoClick" style="-fx-text-fill: #E8A838; -fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: Georgia; -fx-cursor: hand;" text="Singgah" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Center Pill Navigation (Kelola Homestay & Kelola Reservasi) -->
            <HBox alignment="CENTER" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 30;">
                <padding>
                    <Insets bottom="6.0" left="20.0" right="20.0" top="6.0" />
                </padding>
                <Button fx:id="navKelolaBtn" onAction="#handleShowKelolaHomestay" style="-fx-background-color: #E8EDE8; -fx-text-fill: #1B431E; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 15; -fx-padding: 5 16 5 16; -fx-cursor: hand;" text="Kelola Homestay" />
                <Button onAction="#handleGoToKelolaReservasi" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 5 16 5 16; -fx-cursor: hand;" text="Kelola Reservasi" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Profile Button -->
            <Button onAction="#handleProfileClick" prefHeight="38.0" prefWidth="38.0" style="-fx-background-color: white; -fx-background-radius: 50; -fx-cursor: hand; -fx-padding: 0;">
                <graphic>
                    <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@images/ProfileIcon.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- Hero Section Host -->
        <StackPane alignment="CENTER_LEFT" minHeight="220.0" style="-fx-background-color: #265229;">
            <padding>
                <Insets bottom="36.0" left="64.0" right="64.0" top="36.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <VBox maxWidth="640.0" spacing="10.0">
                    <VBox spacing="-2.0">
                        <Label style="-fx-text-fill: white; -fx-font-size: 38px; -fx-font-weight: bold;" text="Kelola Homestay," />
                        <Label style="-fx-text-fill: #E8A838; -fx-font-size: 38px; -fx-font-weight: bold;" text="Host Dashboard Singgah." />
                    </VBox>
                    <Label fx:id="welcomeHostLabel" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px;" text="Tambah listing properti dan edit detail kamar homestay Anda." wrapText="true" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Ringkasan Cepat -->
                <HBox spacing="14.0">
                    <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 14; -fx-padding: 14 22 14 22;">
                        <Label fx:id="statTotalVillaLabel" style="-fx-text-fill: #E8A838; -fx-font-size: 26px; -fx-font-weight: bold;" text="3" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="Listing Aktif" />
                    </VBox>
                    <VBox alignment="CENTER" onMouseClicked="#handleGoToKelolaReservasi" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 14; -fx-padding: 14 22 14 22; -fx-cursor: hand;">
                        <Label fx:id="statTotalBookingLabel" style="-fx-text-fill: #E8A838; -fx-font-size: 26px; -fx-font-weight: bold;" text="0" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="Kamar Direservasi" />
                    </VBox>
                </HBox>
            </HBox>
        </StackPane>

        <!-- Main Body Container: Kelola Homestay -->
        <VBox spacing="24.0">
            <padding>
                <Insets bottom="56.0" left="64.0" right="64.0" top="32.0" />
            </padding>

            <VBox fx:id="kelolaSection" spacing="18.0">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="3.0">
                        <Label fx:id="villaSectionTitle" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Kelola Homestay &amp; Daftar Kamar" />
                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px;" text="Tambahkan listing homestay baru atau klik 'Edit Kamar' untuk memperbarui informasi dan foto kamar" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="toggleFormBtn" onAction="#handleOpenAddForm" style="-fx-background-color: #E8A838; -fx-text-fill: #163819; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 22; -fx-padding: 9 20 9 20; -fx-cursor: hand;" text="+ Tambah Listing" />
                </HBox>

                <!-- Form Tambah Listing / Edit Kamar -->
                <VBox fx:id="villaFormCard" managed="false" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 14, 0.1, 0, 4);" visible="false">
                    <padding>
                        <Insets bottom="24.0" left="28.0" right="28.0" top="22.0" />
                    </padding>

                    <Label fx:id="formTitleLabel" style="-fx-text-fill: #163819; -fx-font-size: 18px; -fx-font-weight: bold;" text="Tambah Listing Homestay Baru" />

                    <HBox spacing="16.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #245228; -fx-font-weight: bold; -fx-font-size: 12px;" text="Nama Homestay / Villa" />
                            <TextField fx:id="villaNameField" promptText="Contoh: Agung Villa" style="-fx-border-color: #8BA38D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12 8 12;" />
                        </VBox>

                        <VBox spacing="4.0" prefWidth="200.0">
                            <Label style="-fx-text-fill: #245228; -fx-font-weight: bold; -fx-font-size: 12px;" text="Kabupaten / Kota" />
                            <ComboBox fx:id="regencyComboBox" maxWidth="Infinity" promptText="Pilih Kabupaten" style="-fx-border-color: #8BA38D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: white;" />
                        </VBox>

                        <VBox spacing="4.0" prefWidth="140.0">
                            <Label style="-fx-text-fill: #245228; -fx-font-weight: bold; -fx-font-size: 12px;" text="Maks. Tamu" />
                            <TextField fx:id="maxGuestsField" promptText="Contoh: 4" style="-fx-border-color: #8BA38D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12 8 12;" />
                        </VBox>

                        <VBox spacing="4.0" prefWidth="180.0">
                            <Label style="-fx-text-fill: #245228; -fx-font-weight: bold; -fx-font-size: 12px;" text="Harga / Malam (Rp)" />
                            <TextField fx:id="priceField" promptText="Contoh: 350000" style="-fx-border-color: #8BA38D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12 8 12;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="16.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #245228; -fx-font-weight: bold; -fx-font-size: 12px;" text="Alamat Lengkap" />
                            <TextField fx:id="addressField" promptText="Contoh: Jl. Pantai Batu Bolong No. 10, Canggu, Badung" style="-fx-border-color: #8BA38D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12 8 12;" />
                        </VBox>

                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #245228; -fx-font-weight: bold; -fx-font-size: 12px;" text="Detail &amp; Fasilitas Kamar" />
                            <TextField fx:id="facilitiesField" promptText="Contoh: Kamar mandi dalam • Wi-Fi • Sarapan" style="-fx-border-color: #8BA38D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12 8 12;" />
                        </VBox>
                    </HBox>

                    <!-- Opsi Upload / Pilih Foto Homestay atau Kamar -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #245228; -fx-font-weight: bold; -fx-font-size: 12px;" text="Foto Homestay / Kamar (Opsional)" />
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Button onAction="#handleChooseImage" style="-fx-background-color: #E8EDE8; -fx-text-fill: #1B431E; -fx-font-weight: bold; -fx-font-size: 12px; -fx-border-color: #8BA38D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 7 14 7 14; -fx-cursor: hand;" text="Pilih Foto..." />
                                <Button fx:id="clearImageBtn" managed="false" onAction="#handleClearImage" style="-fx-background-color: transparent; -fx-text-fill: #B84A27; -fx-font-size: 12px; -fx-underline: true; -fx-cursor: hand;" text="Hapus Foto" visible="false" />
                                <Label fx:id="selectedImageLabel" style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="Belum ada foto dipilih (tampil polosan)" />
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button onAction="#handleCloseForm" style="-fx-background-color: #E8EDE8; -fx-text-fill: #1B431E; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18 8 18; -fx-cursor: hand;" text="Batal" />
                        <Button fx:id="saveVillaBtn" onAction="#handleSaveVilla" style="-fx-background-color: #245228; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 22 8 22; -fx-cursor: hand;" text="Simpan Listing" />
                    </HBox>
                </VBox>

                <!-- Kartu-kartu Listing Villa -->
                <FlowPane fx:id="hostVillasContainer" hgap="24.0" prefWrapLength="990.0" vgap="24.0" />
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>