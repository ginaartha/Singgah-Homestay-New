<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="760.0" prefWidth="1120.0"
            style="-fx-background: #1B431E; -fx-background-color: #1B431E;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <VBox fillWidth="true" style="-fx-background-color: #1B431E;">

        //navbar
        <HBox alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-background-color: #163819; -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="16.0" left="48.0" right="48.0" top="16.0" />
            </padding>

            <Label text="Singgah"
                   style="-fx-text-fill: #E8A838; -fx-font-size: 22px; -fx-font-weight: bold;" />

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="18.0"
                  style="-fx-background-color: white; -fx-background-radius: 30;">
                <padding>
                    <Insets bottom="6.0" left="22.0" right="22.0" top="6.0" />
                </padding>
                <Button text="Beranda"
                        style="-fx-background-color: transparent; -fx-text-fill: #1B431E; -fx-font-weight: bold; -fx-font-size: 13px;" />
                <Button text="Cari Kamar"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;" />
                <Button text="Reservasi Saya"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Daftar"
                    style="-fx-background-color: white; -fx-text-fill: #1B431E; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 7 20 7 20;" />
            <Button text="Masuk"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 20 6 20;" />
        </HBox>

        //hero
        <StackPane alignment="CENTER_LEFT" minHeight="320.0"
                   style="-fx-background-color: #265229;">
            <padding>
                <Insets bottom="50.0" left="64.0" right="64.0" top="45.0" />
            </padding>

            <VBox maxWidth="540.0" spacing="12.0">
                <VBox spacing="-4.0">
                    <Label text="Find Your Stay,"
                           style="-fx-text-fill: white; -fx-font-size: 44px; -fx-font-weight: bold;" />
                    <Label text="Singgah in Bali."
                           style="-fx-text-fill: #E8A838; -fx-font-size: 44px; -fx-font-weight: bold;" />
                </VBox>
                <Label text="Temukan homestay nyaman di berbagai daerah Bali untuk liburan yang bermakna."
                       wrapText="true"
                       style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px;" />
            </VBox>
        </StackPane>

        <!-- Search Bar -->
        <HBox alignment="CENTER" style="-fx-translate-y: -28;">
            <HBox alignment="CENTER" spacing="18.0"
                  style="-fx-background-color: white; -fx-background-radius: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 14, 0.1, 0, 4);">
                <padding>
                    <Insets bottom="14.0" left="24.0" right="20.0" top="14.0" />
                </padding>

                <ComboBox prefWidth="220.0" promptText="Pilih Kabupaten/Kota di Bali"
                          style="-fx-background-color: transparent; -fx-font-size: 13px;" />
                <DatePicker prefWidth="140.0" promptText="Tanggal"
                            style="-fx-background-color: transparent; -fx-font-size: 13px;" />
                <ComboBox prefWidth="140.0" promptText="Jumlah tamu"
                          style="-fx-background-color: transparent; -fx-font-size: 13px;" />
                <Button text="Cek Ketersediaan"
                        style="-fx-background-color: #245228; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 25; -fx-padding: 10 22 10 22;" />
            </HBox>
        </HBox>

        <!-- Villa Cards Row -->
        <HBox alignment="CENTER" spacing="24.0">
            <padding>
                <Insets bottom="48.0" left="64.0" right="64.0" top="8.0" />
            </padding>

            <!-- Card 1 -->
            <VBox prefWidth="300.0"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 12, 0.1, 0, 3);">
                <StackPane minHeight="170.0"
                           style="-fx-background-color: #4A6F4D; -fx-background-radius: 16 16 0 0;">
                    <Label text="Villa Photo" style="-fx-text-fill: white; -fx-font-size: 13px;" />
                </StackPane>

                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="14.0" />
                    </padding>
                    <Label text="Ubud, Bali" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                    <Label text="Dhyana Villa" style="-fx-text-fill: #1A1A1A; -fx-font-size: 18px; -fx-font-weight: bold;" />
                    <Label text="2 tamu • Kamar mandi dalam • Wi-Fi" style="-fx-text-fill: #777777; -fx-font-size: 11px;" />

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <padding>
                            <Insets top="8.0" />
                        </padding>
                        <Label text="Rp 250.000,00/malam"
                               style="-fx-text-fill: #B84A27; -fx-font-size: 14px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Booking"
                                style="-fx-background-color: #245228; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 16 6 16;" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Card 2 -->
            <VBox prefWidth="300.0"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 12, 0.1, 0, 3);">
                <StackPane minHeight="170.0"
                           style="-fx-background-color: #4A6F4D; -fx-background-radius: 16 16 0 0;">
                    <Label text="Villa Photo" style="-fx-text-fill: white; -fx-font-size: 13px;" />
                </StackPane>

                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="14.0" />
                    </padding>
                    <Label text="Ubud, Bali" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                    <Label text="Dhyana Villa" style="-fx-text-fill: #1A1A1A; -fx-font-size: 18px; -fx-font-weight: bold;" />
                    <Label text="2 tamu • Kamar mandi dalam • Wi-Fi" style="-fx-text-fill: #777777; -fx-font-size: 11px;" />

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <padding>
                            <Insets top="8.0" />
                        </padding>
                        <Label text="Rp 250.000,00/malam"
                               style="-fx-text-fill: #B84A27; -fx-font-size: 14px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Booking"
                                style="-fx-background-color: #245228; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 16 6 16;" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Card 3 -->
            <VBox prefWidth="300.0"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 12, 0.1, 0, 3);">
                <StackPane minHeight="170.0"
                           style="-fx-background-color: #4A6F4D; -fx-background-radius: 16 16 0 0;">
                    <Label text="Villa Photo" style="-fx-text-fill: white; -fx-font-size: 13px;" />
                </StackPane>

                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="14.0" />
                    </padding>
                    <Label text="Ubud, Bali" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                    <Label text="Dhyana Villa" style="-fx-text-fill: #1A1A1A; -fx-font-size: 18px; -fx-font-weight: bold;" />
                    <Label text="2 tamu • Kamar mandi dalam • Wi-Fi" style="-fx-text-fill: #777777; -fx-font-size: 11px;" />

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <padding>
                            <Insets top="8.0" />
                        </padding>
                        <Label text="Rp 250.000,00/malam"
                               style="-fx-text-fill: #B84A27; -fx-font-size: 14px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Booking"
                                style="-fx-background-color: #245228; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 16 6 16;" />
                    </HBox>
                </VBox>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>