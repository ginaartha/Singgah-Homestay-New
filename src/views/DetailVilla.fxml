<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="760.0" prefWidth="1120.0" style="-fx-background: #265229; -fx-background-color: #265229;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DetailVillaController">

    <VBox fillWidth="true" minHeight="758.0" style="-fx-background-color: #265229;">

        <!-- Top Navbar -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #163819;">
            <padding>
                <Insets bottom="16.0" left="48.0" right="48.0" top="16.0" />
            </padding>

            <ImageView fitHeight="45.0" fitWidth="45.0" onMouseClicked="#handleHome" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                <image>
                    <Image url="@images/SinggahLogo.png" />
                </image>
            </ImageView>

            <Label onMouseClicked="#handleHome" style="-fx-text-fill: #E8A838; -fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: Georgia; -fx-cursor: hand;" text="Singgah" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Center Pill Menu (Cari Kamar Active) -->
            <HBox alignment="CENTER" spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 30;">
                <padding>
                    <Insets bottom="6.0" left="22.0" right="22.0" top="6.0" />
                </padding>
                <Button onAction="#handleHome" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand;" text="Beranda" />
                <Button onAction="#handleSearchRoom" style="-fx-background-color: #E8EDE8; -fx-text-fill: #1B431E; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 15; -fx-padding: 4 14 4 14; -fx-cursor: hand;" text="Cari Kamar" />
                <Button onAction="#handleMyReservations" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand;" text="Reservasi Saya" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Guest Buttons (Shown when logged out) -->
            <HBox fx:id="authButtonsBox" alignment="CENTER" spacing="10.0">
                <Button onAction="#handleRegister" style="-fx-background-color: white; -fx-text-fill: #1B431E; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 7 20 7 20; -fx-cursor: hand;" text="Daftar" />
                <Button onAction="#handleLogin" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 20 6 20; -fx-cursor: hand;" text="Masuk" />
            </HBox>

            <!-- Profile Button (Shown when logged in) -->
            <Button fx:id="profileButton" managed="false" onAction="#handleProfileClick" prefHeight="38.0" prefWidth="38.0" style="-fx-background-color: white; -fx-background-radius: 50; -fx-cursor: hand; -fx-padding: 0;" visible="false">
                <graphic>
                    <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@images/ProfileIcon.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- Main Content -->
        <VBox spacing="20.0">
            <padding>
                <Insets bottom="48.0" left="84.0" right="84.0" top="28.0" />
            </padding>

            <!-- Photo Gallery (1 Large Left + 3 Right Grid) -->
            <HBox spacing="12.0">
                <!-- Large Left Image -->
                <StackPane maxHeight="270.0" maxWidth="380.0" minHeight="270.0" minWidth="380.0" style="-fx-background-color: #163819; -fx-background-radius: 12; -fx-border-color: #112B14; -fx-border-radius: 12;">
                    <ImageView fx:id="mainPhotoView" fitHeight="268.0" fitWidth="378.0" pickOnBounds="true" preserveRatio="false">
                        <image>
                            <Image url="@images/DhyanaVilla.png" />
                        </image>
                    </ImageView>
                </StackPane>

                <!-- Right 2-Row Photo Stack -->
                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                    <!-- Top 2 Photos -->
                    <HBox spacing="12.0">
                        <StackPane maxHeight="135.0" minHeight="135.0" style="-fx-background-color: #163819; -fx-background-radius: 12; -fx-border-color: #112B14; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                            <ImageView fx:id="subPhoto1View" fitHeight="133.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="false">
                                <image>
                                    <Image url="@images/DhyanaVilla.png" />
                                </image>
                            </ImageView>
                        </StackPane>

                        <StackPane maxHeight="135.0" minHeight="135.0" style="-fx-background-color: #163819; -fx-background-radius: 12; -fx-border-color: #112B14; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                            <ImageView fx:id="subPhoto2View" fitHeight="133.0" fitWidth="320.0" pickOnBounds="true" preserveRatio="false">
                                <image>
                                    <Image url="@images/DhyanaVilla.png" />
                                </image>
                            </ImageView>
                        </StackPane>
                    </HBox>

                    <!-- Bottom Wide Photo -->
                    <StackPane maxHeight="123.0" minHeight="123.0" style="-fx-background-color: #163819; -fx-background-radius: 12; -fx-border-color: #112B14; -fx-border-radius: 12;">
                        <ImageView fx:id="subPhoto3View" fitHeight="121.0" fitWidth="552.0" pickOnBounds="true" preserveRatio="false">
                            <image>
                                <Image url="@images/DhyanaVilla.png" />
                            </image>
                        </ImageView>
                    </StackPane>
                </VBox>
            </HBox>

            <!-- Light Gray Details & Booking Box -->
            <HBox alignment="TOP_LEFT" spacing="36.0" style="-fx-background-color: #D8DCD8; -fx-background-radius: 12; -fx-border-color: #1A1A1A; -fx-border-width: 1.5; -fx-border-radius: 12;">
                <padding>
                    <Insets bottom="28.0" left="32.0" right="32.0" top="26.0" />
                </padding>

                <!-- Left Column: Title, Rating & Description -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="villaNameLabel" style="-fx-text-fill: #111111; -fx-font-size: 26px; -fx-font-weight: bold;" text="Dhyana Villa" />

                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label style="-fx-text-fill: #E8A838; -fx-font-size: 13px; -fx-font-weight: bold;" text="★ 5.00" />
                        <Label style="-fx-text-fill: #222222; -fx-font-size: 12px; -fx-font-weight: bold; -fx-underline: true;" text="100 ulasan" />
                    </HBox>

                    <Label style="-fx-text-fill: #222222; -fx-font-size: 13px;" text="Villa nyaman bernuansa tropis Bali dengan kolam renang pribadi." />

                    <Separator>
                        <VBox.margin>
                            <Insets bottom="6.0" top="6.0" />
                        </VBox.margin>
                    </Separator>

                    <Label fx:id="villaDescriptionLabel" style="-fx-text-fill: #222222; -fx-font-size: 13px; -fx-line-spacing: 3;" text="Nikmati ketenangan liburan di Bali dengan fasilitas lengkap mulai dari kamar tidur luas, kamar mandi dalam modern, Wi-Fi berkecepatan tinggi, area bersantai tepi kolam, serta akses mudah ke destinasi wisata dan kuliner lokal terbaik." wrapText="true" />

                    <Separator>
                        <VBox.margin>
                            <Insets bottom="6.0" top="6.0" />
                        </VBox.margin>
                    </Separator>

                    <Label fx:id="villaFacilitiesLabel" style="-fx-text-fill: #222222; -fx-font-size: 13px;" text="Fasilitas: 2 tamu • Kamar mandi dalam • Wi-Fi • Kolam Renang" />
                </VBox>

                <!-- Right Column: Address + White Booking Widget -->
                <VBox maxWidth="360.0" minWidth="360.0" spacing="14.0">
                    <!-- Address Row -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-text-fill: #163819; -fx-font-size: 20px;" />
                        <Label fx:id="villaAddressLabel" style="-fx-text-fill: #111111; -fx-font-size: 13px; -fx-font-weight: bold;" text="Jl. Menuju Hatimu, No. 01, Kec. Klungkung, Kab. Klungkung, Bali" wrapText="true" />
                    </HBox>

                    <!-- White Booking Card -->
                    <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #8BA38D; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0.1, 0, 3);">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="18.0" />
                        </padding>

                        <!-- Price Header -->
                        <HBox alignment="BASELINE_LEFT" spacing="4.0">
                            <Label style="-fx-text-fill: #222222; -fx-font-size: 13px;" text="Mulai dari" />
                            <Label fx:id="villaPriceLabel" style="-fx-text-fill: #111111; -fx-font-size: 14px; -fx-font-weight: bold; -fx-underline: true;" text="Rp250.000,00" />
                            <Label style="-fx-text-fill: #222222; -fx-font-size: 13px;" text="per Malam" />
                        </HBox>

                        <!-- Joined Check-in / Check-out / Guest Input Grid -->
                        <VBox style="-fx-border-color: #999999; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <!-- Top Row: Check-in & Check-out -->
                            <HBox>
                                <VBox spacing="2.0" style="-fx-border-color: transparent #999999 #999999 transparent; -fx-padding: 6 10 6 10;" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #222222; -fx-font-size: 9px; -fx-font-weight: bold;" text="CHECK-IN" />
                                    <DatePicker fx:id="checkInPicker" prefWidth="140.0" style="-fx-background-color: transparent; -fx-font-size: 11px;" />
                                </VBox>

                                <VBox spacing="2.0" style="-fx-border-color: transparent transparent #999999 transparent; -fx-padding: 6 10 6 10;" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #222222; -fx-font-size: 9px; -fx-font-weight: bold;" text="CHECKOUT" />
                                    <DatePicker fx:id="checkOutPicker" prefWidth="140.0" style="-fx-background-color: transparent; -fx-font-size: 11px;" />
                                </VBox>
                            </HBox>

                            <!-- Bottom Row: Jumlah Tamu -->
                            <VBox spacing="2.0" style="-fx-padding: 6 10 6 10;">
                                <Label style="-fx-text-fill: #222222; -fx-font-size: 10px; -fx-font-weight: bold;" text="Jumlah Tamu" />
                                <ComboBox fx:id="guestCountComboBox" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-font-size: 12px;" />
                            </VBox>
                        </VBox>

                        <!-- Action Button -->
                        <Button maxWidth="Infinity" onAction="#handlePilihKamar" style="-fx-background-color: #365C39; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 20 10 20; -fx-cursor: hand;" text="Pilih Kamar" />
                    </VBox>
                </VBox>

            </HBox>
        </VBox>

    </VBox>
</ScrollPane>