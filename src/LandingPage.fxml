<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:controller="LandingPageController" fitToWidth="true" hbarPolicy="NEVER" prefHeight="760.0" prefWidth="1120.0" style="-fx-background: #1B431E; -fx-background-color: #1B431E;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <VBox fillWidth="true" style="-fx-background-color: #1B431E;">

<!-- navbar -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #163819; -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="16.0" left="48.0" right="48.0" top="16.0" />
            </padding>

            <ImageView fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@images/SinggahLogo.png" />
                </image>
            </ImageView>

            <Label style="-fx-text-fill: #E8A838; -fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: Georgia; " text="Singgah" />

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 30;">
                <padding>
                    <Insets bottom="6.0" left="22.0" right="22.0" top="6.0" />
                </padding>
                <Button fx:id="homeButton" onAction="#handleHome" style="-fx-background-color: transparent; -fx-text-fill: #1B431E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Beranda" />
                <Button fx:id="searchRoomButton" onAction="#handleSearchRoom" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;" text="Cari Kamar" />
                <Button fx:id="myReservationsButton" onAction="#handleMyReservations" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;" text="Reservasi Saya" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Guest Buttons (Shown when logged out) -->
            <HBox fx:id="authButtonsBox" alignment="CENTER" spacing="10.0">
                <Button fx:id="registerButton" onAction="#handleRegister" style="-fx-background-color: white; -fx-text-fill: #1B431E; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 7 20 7 20; -fx-cursor: hand;" text="Daftar" />
                <Button fx:id="loginButton" onAction="#handleLogin" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: white; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 20 6 20; -fx-cursor: hand;" text="Masuk" />
            </HBox>

            <!-- Profile Button (Shown when logged in, styled like Screenshot 3) -->
            <Button fx:id="profileButton" managed="false" onAction="#handleProfileClick" prefHeight="38.0" prefWidth="38.0" style="-fx-background-color: white; -fx-background-radius: 50; -fx-text-fill: #1B431E; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" text="👤" visible="false" />
        </HBox>

        <!-- Hero Section -->
        <StackPane alignment="CENTER_LEFT" minHeight="320.0" style="-fx-background-color: #265229;">
            <padding>
                <Insets bottom="50.0" left="64.0" right="64.0" top="45.0" />
            </padding>

            <VBox maxWidth="540.0" spacing="12.0">
                <VBox spacing="-4.0">
                    <Label style="-fx-text-fill: white; -fx-font-size: 44px; -fx-font-weight: bold;" text="Find Your Stay," />
                    <Label style="-fx-text-fill: #E8A838; -fx-font-size: 44px; -fx-font-weight: bold;" text="Singgah in Bali." />
                </VBox>
                <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px;" text="Temukan homestay nyaman di berbagai daerah Bali untuk liburan yang bermakna." wrapText="true" />
            </VBox>
        </StackPane>

        <!-- Search Bar -->
        <HBox alignment="CENTER" style="-fx-translate-y: -28;">
            <HBox alignment="CENTER" spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 14, 0.1, 0, 4);">
                <padding>
                    <Insets bottom="14.0" left="24.0" right="20.0" top="14.0" />
                </padding>

                <ComboBox fx:id="locationComboBox" prefWidth="220.0" promptText="Pilih Kabupaten/Kota di Bali" style="-fx-background-color: transparent; -fx-font-size: 13px;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Badung" />
                            <String fx:value="Bangli" />
                            <String fx:value="Buleleng" />
                            <String fx:value="Denpasar" />
                            <String fx:value="Gianyar" />
                            <String fx:value="Jembrana" />
                            <String fx:value="Karangasem" />
                            <String fx:value="Klungkung" />
                            <String fx:value="Tabanan" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <DatePicker fx:id="datePicker" prefWidth="140.0" promptText="Tanggal" style="-fx-background-color: transparent; -fx-font-size: 13px;" />

                <ComboBox fx:id="guestComboBox" prefWidth="140.0" promptText="Jumlah tamu" style="-fx-background-color: transparent; -fx-font-size: 13px;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="1 tamu" />
                            <String fx:value="2 tamu" />
                            <String fx:value="3 tamu" />
                            <String fx:value="4 tamu" />
                            <String fx:value="5+ tamu" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <Button fx:id="checkAvailabilityButton" onAction="#handleCheckAvailability" style="-fx-background-color: #245228; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 25; -fx-padding: 10 22 10 22;" text="Cek Ketersediaan" />
            </HBox>
        </HBox>

        <!-- Villa Cards Row -->
        <HBox alignment="CENTER" spacing="24.0">
            <padding>
                <Insets bottom="56.0" left="64.0" right="64.0" top="8.0" />
            </padding>

            <!-- Card 1 -->
            <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 12, 0.1, 0, 3);">
                <StackPane minHeight="170.0" prefHeight="170.0" style="-fx-background-color: #4A6F4D; -fx-background-radius: 16 16 0 0;">
                    <ImageView fitHeight="170.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="false">
                        <image>
                            <Image url="@images/DhyanaVilla.png" />
                        </image>
                    </ImageView>
                </StackPane>

                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="20.0" left="18.0" right="18.0" top="14.0" />
                    </padding>
                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Ubud, Bali" />
                    <Label style="-fx-text-fill: #1A1A1A; -fx-font-size: 18px; -fx-font-weight: bold;" text="Dhyana Villa" />
                    <Label style="-fx-text-fill: #777777; -fx-font-size: 11px;" text="2 tamu • Kamar mandi dalam • Wi-Fi" />

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <padding>
                            <Insets top="8.0" />
                        </padding>
                        <Label style="-fx-text-fill: #B84A27; -fx-font-size: 14px; -fx-font-weight: bold;" text="Rp 250.000,00/malam" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleBookingVilla1" style="-fx-background-color: #245228; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 16 6 16;" text="Booking" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Card 2 -->
            <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 12, 0.1, 0, 3);">
                <StackPane minHeight="170.0" prefHeight="170.0" style="-fx-background-color: #4A6F4D; -fx-background-radius: 16 16 0 0;">
                    <ImageView fitHeight="170.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="false">
                        <image>
                            <Image url="@images/DhyanaVilla.png" />
                        </image>
                    </ImageView>
                </StackPane>

                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="20.0" left="18.0" right="18.0" top="14.0" />
                    </padding>
                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Ubud, Bali" />
                    <Label style="-fx-text-fill: #1A1A1A; -fx-font-size: 18px; -fx-font-weight: bold;" text="Dhyana Villa" />
                    <Label style="-fx-text-fill: #777777; -fx-font-size: 11px;" text="2 tamu • Kamar mandi dalam • Wi-Fi" />

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <padding>
                            <Insets top="8.0" />
                        </padding>
                        <Label style="-fx-text-fill: #B84A27; -fx-font-size: 14px; -fx-font-weight: bold;" text="Rp 250.000,00/malam" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleBookingVilla2" style="-fx-background-color: #245228; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 16 6 16;" text="Booking" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Card 3 -->
            <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 12, 0.1, 0, 3);">
                <StackPane minHeight="170.0" prefHeight="170.0" style="-fx-background-color: #4A6F4D; -fx-background-radius: 16 16 0 0;">
                    <ImageView fitHeight="170.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="false">
                        <image>
                            <Image url="@images/DhyanaVilla.png" />
                        </image>
                    </ImageView>
                </StackPane>

                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="20.0" left="18.0" right="18.0" top="14.0" />
                    </padding>
                    <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Ubud, Bali" />
                    <Label style="-fx-text-fill: #1A1A1A; -fx-font-size: 18px; -fx-font-weight: bold;" text="Dhyana Villa" />
                    <Label style="-fx-text-fill: #777777; -fx-font-size: 11px;" text="2 tamu • Kamar mandi dalam • Wi-Fi" />

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <padding>
                            <Insets top="8.0" />
                        </padding>
                        <Label style="-fx-text-fill: #B84A27; -fx-font-size: 14px; -fx-font-weight: bold;" text="Rp 250.000,00/malam" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleBookingVilla3" style="-fx-background-color: #245228; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 6 16 6 16;" text="Booking" />
                    </HBox>
                </VBox>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>